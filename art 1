<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>AI-enabled Role Evolution — HSBC</title>
<style>
/* ============================================================
   1. TOKENS
   ============================================================ */
:root{
  --red:#DB0011;
  --red-d:#A5000D;
  --white:#FFFFFF;
  --g1:#F7F7F7;
  --g2:#EFEFEF;
  --line:#E3E3E3;
  --line2:#D8D8D8;
  --ink:#1A1A1A;
  --ink2:#5C5C5C;
  --muted:#8A8A8A;
  --green:#0F7A3D;
  --font:-apple-system,"Segoe UI","Helvetica Neue",Arial,"Noto Sans SC","PingFang SC","Microsoft YaHei",sans-serif;
}

/* ============================================================
   2. BASE / STAGE
   ============================================================ */
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;overflow:hidden;background:#E8E8E8;font-family:var(--font);color:var(--ink)}
#viewport{
  position:absolute;top:50%;left:50%;
  width:1920px;height:1080px;
  transform-origin:center center;
}
.stage{
  width:100%;height:100%;background:var(--white);
  display:flex;flex-direction:column;overflow:hidden;
}
.toprule{flex:0 0 4px;background:var(--red)}

/* ============================================================
   3. HEADER
   ============================================================ */
.hdr{
  flex:0 0 62px;display:flex;align-items:center;gap:14px;
  padding:0 22px;border-bottom:1px solid var(--line);
}
.brand{display:flex;align-items:center;gap:11px}
.wordmark{font-size:19px;font-weight:700;letter-spacing:2.6px;color:var(--ink)}
.hdr .vrule{width:1px;height:34px;background:var(--line2);margin:0 4px}
.hdr-title{font-size:19px;font-weight:600;letter-spacing:.2px;line-height:1.1}
.hdr-sub{font-size:9.5px;color:var(--ink2);letter-spacing:1.6px;text-transform:uppercase;margin-top:3px;font-weight:600}
.hdr-right{margin-left:auto;display:flex;align-items:center;gap:18px}

.tag-internal{
  font-size:9.5px;letter-spacing:1.6px;font-weight:700;color:var(--red);
  border:1px solid var(--red);padding:3px 7px;white-space:nowrap;
}
.seg{display:flex;border:1px solid var(--line2)}
.seg button{
  font-family:inherit;font-size:10.5px;letter-spacing:.6px;font-weight:600;
  padding:5px 11px;background:var(--white);color:var(--ink2);
  border:0;cursor:pointer;transition:background .12s,color .12s;
}
.seg button+button{border-left:1px solid var(--line2)}
.seg button.on{background:var(--red);color:#fff}
.seg button:hover:not(.on){background:var(--g2)}

/* minimap nav */
.mini{position:relative;display:flex;padding-top:0}
.mini::before{
  content:"";position:absolute;left:30px;right:30px;top:5px;height:1px;background:var(--line2);
}
.mini button{
  position:relative;z-index:1;width:70px;background:none;border:0;cursor:pointer;
  font-family:inherit;display:flex;flex-direction:column;align-items:center;gap:6px;padding:0;
}
.mini .dot{
  width:11px;height:11px;border-radius:50%;background:#fff;
  border:1px solid var(--line2);transition:background .12s,border-color .12s;
}
.mini .lbl{font-size:9px;line-height:1.15;letter-spacing:.2px;color:var(--ink2);text-align:center}
.mini button.on .dot{background:var(--red);border-color:var(--red)}
.mini button.on .lbl{color:var(--red);font-weight:700}
.mini button:focus-visible{outline:2px solid var(--red);outline-offset:3px}
.mini button:hover .dot{border-color:var(--red)}

/* ============================================================
   4. VIEWS
   ============================================================ */
#views{flex:1 1 auto;min-height:0;position:relative;overflow:hidden}
.view{
  position:absolute;inset:0;
  opacity:0;transform:translateY(8px);pointer-events:none;
  transition:opacity .18s ease,transform .18s ease;
}
.view.on{opacity:1;transform:none;pointer-events:auto}

/* shared */
.eyebrow{
  font-size:9.5px;letter-spacing:1.5px;font-weight:700;text-transform:uppercase;color:var(--muted);
}
.shead{
  font-size:12.5px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;
  padding-bottom:6px;border-bottom:2px solid var(--red);margin-bottom:9px;
}
.ssub{font-size:10.5px;color:var(--muted);letter-spacing:.2px;margin:-5px 0 10px}

/* ============================================================
   5. OVERVIEW
   ============================================================ */
.ov{
  height:100%;display:grid;grid-template-rows:minmax(0,1fr) auto auto;
  gap:10px;padding:12px 22px 0;
}
.hero{display:grid;grid-template-columns:1.06fr 1fr 1fr;min-height:0}
.hero>section{
  min-height:0;overflow:hidden;display:flex;flex-direction:column;
  padding:0 20px;border-right:1px solid var(--line);
}
.hero>section:first-child{padding-left:0}
.hero>section:last-child{border-right:0;padding-right:0}

/* --- column 1 --- */
.grp{margin-bottom:13px}
.grp-h{
  font-size:9.5px;letter-spacing:1.5px;font-weight:700;color:var(--ink2);
  text-transform:uppercase;padding-bottom:4px;border-bottom:1px solid var(--line2);margin-bottom:6px;
}
.rrow{
  display:flex;align-items:center;gap:8px;width:calc(100% + 14px);
  margin:0 -7px;padding:5px 7px;background:none;border:1px solid transparent;
  font-family:inherit;text-align:left;cursor:pointer;
  transition:border-color .12s,background .12s;
}
.rrow:hover{border-color:var(--red);background:#FFF6F7}
.rrow:focus-visible{outline:2px solid var(--red);outline-offset:1px}
.chip-cur{
  font-size:10.5px;color:var(--ink2);background:var(--g1);
  border:1px solid var(--line2);padding:2px 7px;white-space:nowrap;
}
.ar{flex:0 0 auto}
.futs{display:flex;flex-direction:column;gap:3px;min-width:0}
.fut{display:flex;align-items:center;flex-wrap:wrap}
.chip-fut{font-size:11.5px;font-weight:700;color:var(--ink);letter-spacing:.1px}
.mt{
  font-size:7.5px;letter-spacing:1px;font-weight:700;color:var(--red);
  border:1px solid var(--red);padding:1px 4px;margin-left:6px;white-space:nowrap;
}
.mt.grey{color:var(--ink2);border-color:var(--line2);letter-spacing:.6px}

/* --- column 2 --- */
.quote{
  font-size:27px;line-height:1.1;font-weight:700;letter-spacing:-.4px;
  color:var(--red);margin:2px 0 8px;
}
.quote-sub{font-size:10.5px;line-height:1.5;color:var(--ink2);margin-bottom:16px}
.omrow{margin-bottom:11px;padding-left:10px;border-left:2px solid var(--line2)}
.omrow .k{font-size:9px;letter-spacing:1.4px;font-weight:700;color:var(--muted);text-transform:uppercase}
.omrow .v{font-size:11.5px;line-height:1.42;color:var(--ink);margin-top:3px}

/* --- column 3 --- */
.mrow{padding:7px 0;border-bottom:1px solid var(--line)}
.mrow .n{font-size:11px;font-weight:700;letter-spacing:.7px;text-transform:uppercase}
.mrow .d{font-size:9.5px;line-height:1.42;color:var(--ink2);margin-top:3px}
.epistrip{display:flex;border:1px solid var(--line2);margin-top:9px}
.epistrip div{
  flex:1;padding:6px 8px;font-size:9.5px;line-height:1.3;
  border-right:1px solid var(--line2);
}
.epistrip div:last-child{border-right:0}
.epistrip .em{display:block;font-size:11px;font-weight:700;margin-bottom:2px}
.epistrip .pos .em{color:var(--green)}
.epistrip .nul .em{color:var(--ink2)}
.epistrip .neg .em{color:var(--red)}
.caution{
  border:1px solid var(--red);background:#FFF8F8;padding:8px 10px;
  font-size:9.5px;line-height:1.45;color:var(--ink);margin-top:9px;
}

/* --- guardrails band --- */
.guard{
  display:flex;border-top:2px solid var(--red);border-bottom:1px solid var(--line);
  background:var(--g1);
}
.guard-h{
  width:186px;flex:0 0 186px;padding:11px 14px;border-right:1px solid var(--line2);
  font-size:10px;font-weight:700;letter-spacing:1.3px;text-transform:uppercase;
  display:flex;align-items:center;line-height:1.3;
}
.guard-cells{flex:1;display:grid;grid-template-columns:repeat(6,1fr)}
.guard-cells span{
  padding:11px 14px;font-size:11.5px;font-weight:600;
  border-right:1px solid var(--line2);display:flex;align-items:center;line-height:1.3;
}
.guard-cells span:last-child{border-right:0}

/* --- bottom band --- */
.bottom{
  display:grid;grid-template-columns:1fr 76px 1fr;
  border-top:1px solid var(--line);padding-top:12px;
}
.panel{border:1px solid var(--line2);padding:12px 14px;background:var(--white)}
.panel h3{
  font-size:11.5px;font-weight:700;letter-spacing:1.3px;text-transform:uppercase;
  padding-bottom:6px;border-bottom:2px solid var(--red);margin-bottom:11px;
}
.pill{
  display:flex;align-items:center;gap:9px;
  border:1px solid var(--line2);border-left:3px solid var(--red);
  background:var(--g1);padding:7px 11px;margin-bottom:6px;
  font-size:11.5px;font-weight:600;line-height:1.3;
}
.pill:last-child{margin-bottom:0}
.panel.big .pill{padding:20px 12px;font-size:12.5px;margin-bottom:8px}
.arrowbig{display:flex;align-items:center;justify-content:center}

/* --- footer --- */
.ftr{
  flex:0 0 30px;display:flex;align-items:center;gap:14px;
  padding:0 22px;border-top:1px solid var(--line);
  font-size:10px;color:var(--muted);letter-spacing:.2px;
}
.ftr .r{margin-left:auto}

/* ============================================================
   6. DETAIL VIEW
   ============================================================ */
.det{height:100%;display:flex;flex-direction:column;padding:12px 22px 0}
.det-head{
  display:flex;align-items:flex-end;gap:16px;
  padding-bottom:9px;border-bottom:2px solid var(--red);margin-bottom:12px;
}
.det-head .grp-eyebrow{
  font-size:9.5px;letter-spacing:1.5px;font-weight:700;text-transform:uppercase;
  color:var(--red);
}
.det-title{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-top:4px}
.det-title .cur{font-size:16px;color:var(--ink2);font-weight:600}
.det-title .fut{font-size:22px;font-weight:700;letter-spacing:-.2px;color:var(--ink)}
.det-title .fut+.fut{margin-left:2px}
.det-head-right{margin-left:auto;display:flex;align-items:center;gap:14px}
.autobadge{border:1px solid var(--red);padding:6px 11px;text-align:right;min-width:172px}
.autobadge .k{font-size:8.5px;letter-spacing:1.3px;font-weight:700;color:var(--muted);text-transform:uppercase}
.autobadge .v{font-size:17px;font-weight:700;color:var(--red);line-height:1.15;margin-top:1px}
.autobadge .s{font-size:9px;color:var(--ink2);margin-top:2px}
.btn-back{
  font-family:inherit;font-size:10.5px;font-weight:600;letter-spacing:.6px;
  background:var(--white);border:1px solid var(--line2);padding:8px 12px;
  cursor:pointer;display:flex;align-items:center;gap:7px;color:var(--ink);
  transition:border-color .12s,color .12s;
}
.btn-back:hover{border-color:var(--red);color:var(--red)}
.btn-back:focus-visible{outline:2px solid var(--red);outline-offset:1px}

.det-grid{flex:1;min-height:0;display:grid;grid-template-columns:58fr 42fr}
.det-grid>div{min-height:0;overflow:hidden}
.det-grid>div:first-child{padding-right:22px;border-right:1px solid var(--line)}
.det-grid>div:last-child{padding-left:22px}

.blk{margin-bottom:14px}
.blk h4{
  font-size:10.5px;letter-spacing:1.4px;text-transform:uppercase;font-weight:700;
  padding-bottom:5px;border-bottom:2px solid var(--red);margin-bottom:9px;
}
.blk .sub-note{font-size:10px;line-height:1.45;color:var(--ink2);margin-bottom:8px}
.direction{
  border-left:3px solid var(--red);background:#FFF8F8;
  padding:7px 11px;font-size:10.5px;line-height:1.45;margin-bottom:13px;
}
.chips{display:flex;flex-wrap:wrap;gap:6px}
.chips span{
  font-size:10.5px;border:1px solid var(--line2);background:var(--g1);
  padding:4px 9px;line-height:1.25;
}
.sub-title{
  font-size:11px;font-weight:700;letter-spacing:.4px;margin:0 0 5px;
}
.sub-title .mt{margin-left:6px}
.blk ul{list-style:none}
.blk li{
  position:relative;padding-left:13px;font-size:11px;line-height:1.4;margin-bottom:5px;
}
.blk li::before{content:"";position:absolute;left:0;top:6px;width:5px;height:5px;background:var(--red)}
.epi-i{display:flex;align-items:flex-start;gap:8px;padding:7px 0;border-bottom:1px solid var(--line)}
.epi-i .dir{flex:0 0 16px;padding-top:2px}
.epi-i .nm{font-size:10.5px;font-weight:700;letter-spacing:.5px;text-transform:uppercase}
.epi-i .nt{font-size:9.5px;color:var(--ink2);line-height:1.4;margin-top:2px}
.autofig{display:flex;align-items:baseline;gap:12px}
.autofig .val{font-size:34px;font-weight:700;color:var(--red);letter-spacing:-1px;line-height:1}
.autofig .st{
  font-size:9.5px;font-weight:700;letter-spacing:1px;text-transform:uppercase;
  border:1px solid var(--red);color:var(--red);padding:3px 7px;
}
.autofig .st.grey{border-color:var(--line2);color:var(--ink2)}
.auto-note{font-size:9.5px;line-height:1.45;color:var(--ink2);margin-top:8px}
.eq-note{
  border:1px solid var(--red);background:#FFF8F8;padding:8px 10px;
  font-size:9.5px;line-height:1.45;margin-top:10px;
}

/* ============================================================
   7. AGENT TABLE VIEW
   ============================================================ */
.agv{height:100%;display:flex;flex-direction:column;padding:12px 22px 0}
.agv-head{display:flex;align-items:flex-end;gap:14px;margin-bottom:10px}
.agv-head h2{font-size:16px;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;
  padding-bottom:5px;border-bottom:2px solid var(--red)}
.agv-head .cnt{margin-left:auto;font-size:10px;color:var(--muted);letter-spacing:1px}
.banner{
  border-left:3px solid var(--red);background:var(--g1);
  padding:9px 13px;font-size:11px;line-height:1.45;margin-bottom:11px;
}
.tblscroll{flex:1;min-height:0;overflow-y:auto;border:1px solid var(--line2)}
table{width:100%;border-collapse:collapse}
thead th{
  position:sticky;top:0;z-index:2;
  background:var(--ink);color:#fff;
  font-size:9.5px;letter-spacing:1.5px;text-transform:uppercase;font-weight:700;
  text-align:left;padding:10px 12px;
}
tbody td{
  padding:9px 12px;font-size:11px;line-height:1.4;vertical-align:top;
  border-bottom:1px solid var(--line);
}
tbody td:first-child{border-left:3px solid var(--red);font-weight:700}
tbody tr:nth-child(even){background:var(--g1)}
tbody tr:hover{background:#FFF6F7}
td .gtag{
  display:inline-block;font-size:9px;letter-spacing:.8px;font-weight:700;
  border:1px solid var(--line2);background:#fff;padding:2px 6px;text-transform:uppercase;
}

/* ============================================================
   8. FLOW VIEW
   ============================================================ */
.flv{height:100%;display:flex;flex-direction:column;padding:12px 22px 0}
.flv-head{display:flex;align-items:flex-end;gap:14px;margin-bottom:14px}
.flv-head h2{font-size:16px;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;
  padding-bottom:5px;border-bottom:2px solid var(--red)}
.flow{display:grid;grid-template-columns:repeat(6,1fr);gap:30px;margin-bottom:14px}
.fnode{
  position:relative;border:1px solid var(--line2);background:#fff;
  padding:12px;display:flex;flex-direction:column;min-height:298px;
}
.fnode::after{
  content:"";position:absolute;top:44px;right:-30px;width:30px;height:2px;background:var(--red);
}
.fnode::before{
  content:"";position:absolute;top:40px;right:-30px;width:0;height:0;
  border-left:7px solid var(--red);border-top:4px solid transparent;border-bottom:4px solid transparent;
}
.fnode:last-child::after,.fnode:last-child::before{display:none}
.fidx{
  width:22px;height:22px;background:var(--red);color:#fff;
  font-size:11px;font-weight:700;display:flex;align-items:center;justify-content:center;
  margin-bottom:9px;
}
.ft{font-size:12px;font-weight:700;line-height:1.3;margin-bottom:10px}
.fmeta{margin-top:auto;border-top:1px solid var(--line);padding-top:6px;margin-bottom:6px}
.fmeta:last-child{margin-bottom:0}
.fmeta .fk{font-size:8.5px;letter-spacing:1.2px;font-weight:700;color:var(--muted);text-transform:uppercase}
.fmeta .fv{font-size:9.5px;line-height:1.38;color:var(--ink2);margin-top:2px}
.fmeta .fv.hot{color:var(--red);font-weight:700}
.defs{display:grid;grid-template-columns:repeat(5,1fr);border-top:2px solid var(--red);
  border-bottom:1px solid var(--line);background:var(--g1);margin-bottom:12px}
.defs div{padding:10px 13px;border-right:1px solid var(--line2)}
.defs div:last-child{border-right:0}
.defs .dk{font-size:9.5px;letter-spacing:1.2px;font-weight:700;text-transform:uppercase;margin-bottom:5px}
.defs .dv{font-size:10px;line-height:1.42;color:var(--ink2)}
.callout{border:1px solid var(--red);padding:11px 14px}
.callout h4{
  font-size:10px;letter-spacing:1.4px;font-weight:700;text-transform:uppercase;
  color:var(--red);margin-bottom:7px;
}
.callout li{
  position:relative;padding-left:13px;font-size:10.5px;line-height:1.45;margin-bottom:5px;color:var(--ink);
}
.callout li:last-child{margin-bottom:0}
.callout li::before{content:"";position:absolute;left:0;top:6px;width:5px;height:5px;background:var(--red)}
.callout ul{list-style:none}

/* ============================================================
   9. EPI & NOTES VIEW
   ============================================================ */
.epv{height:100%;display:grid;grid-template-columns:1fr 1fr;
  gap:0;padding:12px 22px 0}
.epv>div:first-child{padding-right:24px;border-right:1px solid var(--line);min-height:0;overflow:hidden}
.epv>div:last-child{padding-left:24px;min-height:0;overflow:hidden}
.epv h2{
  font-size:14px;font-weight:700;letter-spacing:1.4px;text-transform:uppercase;
  padding-bottom:6px;border-bottom:2px solid var(--red);margin-bottom:11px;
}
.ecard{border:1px solid var(--line2);border-left:3px solid var(--red);padding:10px 13px;margin-bottom:9px}
.ecard .n{font-size:11px;font-weight:700;letter-spacing:.8px;text-transform:uppercase}
.ecard .d{font-size:10px;line-height:1.45;color:var(--ink2);margin-top:4px}
.olist{list-style:none}
.olist li{
  position:relative;padding-left:14px;font-size:11px;line-height:1.5;margin-bottom:9px;
}
.olist li::before{content:"";position:absolute;left:0;top:6px;width:6px;height:6px;background:var(--red)}
.closing{
  border:1px solid var(--line2);background:var(--g1);padding:12px 14px;
  font-size:11.5px;line-height:1.5;font-weight:600;margin-top:4px;
}

/* ============================================================
   10. PRINT
   ============================================================ */
@media print{
  html,body{overflow:visible;height:auto;background:#fff}
  #viewport{position:static;transform:none !important;width:1920px;height:auto}
  .stage{height:auto;display:block;overflow:visible}
  #views{height:auto;overflow:visible}
  .view{
    position:static;opacity:1 !important;transform:none !important;
    pointer-events:auto;height:1080px;page-break-after:always;
  }
  .mini,.seg{display:none}
  .tblscroll{overflow:visible}
}
</style>
</head>
<body>
<div id="viewport">
  <div class="stage">
    <div class="toprule"></div>
    <header class="hdr" id="hdr"></header>
    <main id="views"></main>
    <footer class="ftr" id="ftr"></footer>
  </div>
</div>

<script>
"use strict";

/* ============================================================
   A. i18n DICTIONARY  (single source for every visible string)
   ============================================================ */
const B = (en, zh) => ({ en: en, zh: zh });
let LANG = "en";
const L = (o) => (o && o[LANG] !== undefined) ? o[LANG] : (o && o.en) || "";

const AGENT_TEAM = B("AGENT TEAM", "AGENT TEAM");
const NEW_TAG    = B("NEW", "NEW");
const XDOMAIN    = B("cross-domain · Delivery", "跨域 · Delivery");
const GOVTAG     = B("governance · control", "治理 · 控制");

const UI = {
  appTitle: B("AI-enabled Role Evolution", "AI 驱动的角色演进"),
  appSub:   B("Automated · Augmented · Assured", "自动化 · 增强 · 可验证"),
  internal: B("INTERNAL", "内部"),

  nav: {
    overview: B("Overview", "总览"),
    agents:   B("Agent Overview", "Agent 总览"),
    flow:     B("Engineering Flow", "工程流程"),
    epi:      B("EPI & Notes", "EPI 与说明")
  },

  /* ---- overview column 1 ---- */
  col1Title: B("Role Evolution", "角色演进"),
  col1Sub:   B("Current role → Future role / Agent team", "当前角色 → 未来角色 / Agent 团队"),

  /* ---- overview column 2 ---- */
  col2Title: B("Working Model Change", "工作模式变化"),
  quote:     B("Less meeting. More decision-making.", "更少开会，更多决策。"),
